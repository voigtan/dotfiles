# Modular Brewfile loader
# Set HOMEBREW_BREW_GROUPS (e.g. HOMEBREW_BREW_GROUPS="core work") to install specific groups.
# Defaults to loading all non-ignored groups: core, work, personal.

# get all real folders as the default folders, ignoring the "ignore" file
real_groups = Dir.glob(File.expand_path("brewfiles/Brewfile.*", __dir__)).map { |file| File.basename(file).split(".")[1] }.reject(&:empty?).reject { |group| group == "ignore" }
groups = ENV.fetch("HOMEBREW_BREW_GROUPS", real_groups.join(" ")).split(/[\s,]+/).reject(&:empty?)

groups.each do |group|
  next if group == "ignore"
  path = File.expand_path("brewfiles/Brewfile.#{group}", __dir__)
  instance_eval(File.read(path), path) if File.exist?(path)
end
