[alias]
	his = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	ulog = log --graph --abbrev-commit --decorate --date=relative --all
	s = status -sb
	l = log
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	lg-ascii = "log --color --graph --pretty=format:'%C(#dc322f)%h%C(#ffff00)%d %C(#eee8d5)%s %C(#dc322f)| %C(#586f75)%cr %C(#dc322f)| %C(#586e75)%an%Creset' --abbrev-commit"
	lgg = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)[gpg:%GK%x20%G?]%C(reset)%x20-%x20%an%n%x20%s%n"
	# Show the user email for the current repository.
	whoami = config user.email
	lg-stat = "log --pretty=format:'%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]' --decorate --stat"
	del = branch -D
	br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
	fap = fetch --all --prune

	# Display the largest files in the repository using `git log-large-files <max>`.
	# Set the number of files to display by providing the value of <max> (default is 5).
	log-large-files = "!f() { \
		git rev-list --objects --all \
		| git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' \
		| sed -n 's/^blob //p' \
		| sort --numeric-sort --key=2 \
		| tail -n ${1-5} \
		| cut -c 1-12,41- \
		| $(command -v gnumfmt || echo numfmt) --field=2 --to=iec-i --suffix=B --padding=7 --round=nearest; \
	}; f"

	log-file = "log -p -- $1"

	# Display the documentation comments immediately above a Git alias.
	#
	# Usage:
	#   git alias-help <alias name>
	#
	# Example:
	#   git alias-help dm - Displays the documentation for the `dm` alias.
	alias-help = "!f() { \
		NAME=$1; \
		if [ -z \"$NAME\" ]; then \
			echo \"Usage: git alias-help <alias name>\" >&2; \
			return 2; \
		fi; \
		CONFIG_FILE=${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}; \
		if [ ! -r \"$CONFIG_FILE\" ]; then \
			echo \"Cannot read Git config: $CONFIG_FILE\" >&2; \
			return 1; \
		fi; \
		DOCUMENTATION=$(awk -v alias=\"$NAME\" '/^[[:space:]]*#/ { line=$0; sub(/^[[:space:]]*#[[:space:]]?/, \"\", line); comments=comments line ORS; next } { key=$0; sub(/^[[:space:]]*/, \"\", key); sub(/[[:space:]]*=.*/, \"\", key); if (key == alias) { printf \"%s\", comments; exit } comments=\"\" }' \"$CONFIG_FILE\"); \
		if [ -z \"$DOCUMENTATION\" ]; then \
			echo \"No documentation found for alias: $NAME\" >&2; \
			return 1; \
		fi; \
		printf '%s\\n' \"$DOCUMENTATION\"; \
	}; f"

	log-highscore = "!git shortlog -e --summary --numbered --format='%an (%ae)' \
		| sed -Ee 's/^[[:blank:]]*//g' \
		| bat -l bash --style=numbers,header,grid --file-name '⭐ Highscore ⭐' --tabs=2"

	# list all aliases in the current repository
	aliases = !git config -l | grep alias | cut -c 7-

	# Print a single alias as a one-liner.
	# Usage: git alias-show <alias name>
	alias-show = "!f() { \
		name=$1; \
		if [ -z \"$name\" ]; then \
			echo \"Usage: git alias-show <alias name>\"; \
			return 1; \
		fi; \
		value=$(git config --get \"alias.$name\"); \
		if [ -z \"$value\" ]; then \
			echo \"Alias not found: $name\"; \
			return 1; \
		fi; \
		echo \"$value\" | tr '\\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'; \
		echo; \
	}; f"

	# Save changes to the stash, including untracked files, while keeping staged changes.
	# An optional message can be used for the stash.
	#
	# Usage:
	#   git save
	#   git save [<message>]
	#   git save [-i | --info]
	#
	# Arguments:
	#   <message>  Optional message used as the stash message.
	#
	# Options:
	#   -i, --info  Display this help text and exit. Must be the first argument.
	#
	# Examples:
	#   git save                  Stash changes without a custom message.
	#   git save "before rebase"  Stash changes with a custom message.
	save = "!f() { \
		if [ \"$1\" = \"--info\" ] || [ \"$1\" = \"-i\" ]; then \
			git alias-help save; \
			return 0; \
		fi; \
		if [ -z \"$1\" ]; then \
			git stash --keep-index --include-untracked; \
		else \
			git stash push -m \"$1\" --keep-index --include-untracked; \
		fi; \
	}; f"

	save-all = "!f() { \
		if [ -z \"$1\" ];then \
			git stash --include-untracked; \
		else \
			git stash push -m \"$1\" --include-untracked ; \
		fi; \
	}; f"

	fixup =! sh -c 'SHA =$git rev-parse $1) \
		&& git commit --fixup $SHA \
		&& git rebase -i --autosquash $SHA~ '-

	branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes

	# List local branches by most recent commit and switch to the selected branch.
	#
	# Usage:
	#   git recent
	#   git recent [-i | --info]
	#
	# Arguments:
	#   None.
	#
	# Options:
	#   -i, --info  Display this help text and exit. Must be the first argument.
	#
	# Examples:
	#   git recent   Select a branch interactively with fzf and switch to it.
	recent = "!f() { \
		if [ \"$1\" = \"--info\" ] || [ \"$1\" = \"-i\" ]; then \
			git alias-help recent; \
			return 0; \
		fi; \
		git for-each-ref --sort=-committerdate refs/heads/ --format='%(HEAD)%(color:yellow)%(refname:short)|%(color:bold green)%(committerdate:relative)|%(color:blue)%(subject)|%(color:magenta)%(authorname)%(color:reset)' --color=always \
		| column -ts'|' \
		| fzf --ansi \
		| awk '{print $1}' \
		| xargs git switch; \
	}; f"

	# Create a timestamped WIP branch, commit all changes, and push it to origin.
	#
	# Usage:
	#   git fire
	#   git fire [-i | --info]
	#
	# Arguments:
	#   None.
	#
	# Options:
	#   -i, --info  Display this help text and exit. Must be the first argument.
	#
	# Examples:
	#   git fire   Create and push a timestamped WIP branch containing all changes.
	fire = "!f() { \
		if [ \"$1\" = \"--info\" ] || [ \"$1\" = \"-i\" ]; then \
			git alias-help fire; \
			return 0; \
		fi; \
		BRANCH=\"wip/fire/$USER-$(date +%s)\"; \
		git go $BRANCH && \
		git stage -A && \
		git commit -m \"WIP: fire alarm!\" && \
		git push origin "$BRANCH"; \
	};f"

	# Update the current branch by rebasing it onto a specified branch.
	# With no branch argument, use the default branch of origin.
	#
	# Usage:
	#   git update-branch
	#   git update-branch [<branch-name>]
	#   git update-branch <remote> <branch-name>
	#
	# Arguments:
	#   <branch-name>  Branch to rebase onto; the remote defaults to origin.
	#   <remote>       Remote repository to use with <branch-name>.
	#
	# Options:
	#   -i, --info     Display this help text and exit. Must be the first argument.
	#
	# Examples:
	#   git update-branch                 Rebase onto origin's default branch.
	#   git update-branch main             Rebase onto origin/main.
	#   git update-branch upstream main    Rebase onto upstream/main.
	#   git update-branch -i               Display this documentation.
	update-branch = "!f() { \
		if [ "$1" = "--info" ] || [ "$1" = "-i" ]; then \
			git alias-help update-branch; \
			return 0; \
		fi; \
		if [ $# -le 1 ]; then \
			REMOTE=origin; \
			DEFAULT_REMOTE_REF=$(git symbolic-ref --quiet --short refs/remotes/$REMOTE/HEAD 2>/dev/null); \
			DEFAULT_REMOTE_BRANCH=${DEFAULT_REMOTE_REF#${REMOTE}/}; \
			if [ -z \"$DEFAULT_REMOTE_BRANCH\" ]; then \
				DEFAULT_REMOTE_BRANCH=$(git config --get init.defaultBranch || echo main); \
			fi; \
			BRANCH=${1:-$DEFAULT_REMOTE_BRANCH}; \
		else \
			REMOTE=$1; \
			BRANCH=$2; \
		fi; \
		git fetch $REMOTE $BRANCH && git rebase $REMOTE/$BRANCH; \
	}; f"

	# Deletes local branches that have already been merged into a remote branch.
	#
	# Usage:
	#   git dm
	#   git dm [branch-name]
	#   git dm <remote> <branch-name>
	#
	# Parameters:
	#   [remote]                 The name of the remote repository. Defaults to 'origin'.
	#   [branch-name]            The remote branch to check for merged local branches. Defaults to 'main'.
	#
	# Options:
	#   --info, -i               Show this help message
	#   --dry-run, -n            Show what would be deleted without actually deleting branches
	#
	# Examples:
	#   'git dm'                 Deletes local branches merged into 'origin/main'.
	#   'git dm develop'         Deletes local branches merged into 'origin/develop'.
	#   'git dm upstream main'   Deletes local branches merged into 'upstream/main'.
	#   'git dm --dry-run'       Shows local branches that would be deleted from 'origin/main'.
	#   'git dm -n develop'      Shows local branches that would be deleted from 'origin/develop'.
	#   'git dm -i'              Displays this documentation.
	dm = "!f() { \
		DRY_RUN=false; \
		ARG1=; \
		ARG2=; \
		POSITIONAL_COUNT=0; \
		while [ $# -gt 0 ]; do \
			case \"$1\" in \
				--info|-i) \
					git alias-help dm; \
					return 0; \
					;; \
				--dry-run|-n) \
					DRY_RUN=true; \
					;; \
				*) \
					POSITIONAL_COUNT=$((POSITIONAL_COUNT + 1)); \
					if [ \"$POSITIONAL_COUNT\" -eq 1 ]; then \
						ARG1=$1; \
					elif [ \"$POSITIONAL_COUNT\" -eq 2 ]; then \
						ARG2=$1; \
					else \
						echo \"Usage: git dm [--dry-run|-n] [branch] | git dm [--dry-run|-n] [remote] [branch]\" >&2; \
						return 2; \
					fi; \
					;; \
			esac; \
			shift; \
		done; \
		if [ \"$POSITIONAL_COUNT\" -eq 0 ]; then \
			REMOTE=origin; \
			BRANCH=main; \
		elif [ \"$POSITIONAL_COUNT\" -eq 1 ]; then \
			REMOTE=origin; \
			BRANCH=$ARG1; \
		else \
			REMOTE=$ARG1; \
			BRANCH=$ARG2; \
		fi; \
		TARGET=$REMOTE/$BRANCH; \
		CURRENT=$(git branch --show-current); \
		git fetch \"$REMOTE\" \"$BRANCH\" && \
		git for-each-ref --merged \"$TARGET\" --format='%(refname:short)' refs/heads/ | \
		while IFS= read -r CANDIDATE; do \
			[ \"$CANDIDATE\" = \"$CURRENT\" ] && continue; \
			[ \"$CANDIDATE\" = \"$BRANCH\" ] && continue; \
			if [ \"$DRY_RUN\" = true ]; then \
				printf 'Would delete %s\\n' \"$CANDIDATE\"; \
			else \
				git branch -d -- \"$CANDIDATE\" || exit; \
			fi; \
		done; \
	}; f"

	# Switch to a branch, creating it if needed.
	# With no argument, switch back to the previously checked-out branch.
	#
	# Usage:
	#   git go [<branch-name> | - | !]
	#   git go [-i | --info]
	#
	# Arguments:
	#   <branch-name>  Switch to the branch, creating it if needed.
	#   -              Switch back to the previous branch.
	#   !              Select a recent branch interactively.
	#
	# Options:
	#   -i, --info   Show this help message and exit.
	#
	# Examples:
	#   git go                   Switch back to the previous branch.
	#   git go -                 Switch back explicitly.
	#   git go main              Switch to an existing branch.
	#   git go feature/example   Switch to or create a branch.
	#   git go !                 Pick a branch interactively.
	go = "!f() { \
		if [ \"$1\" = \"--info\" ] || [ \"$1\" = \"-i\" ]; then \
			git alias-help go; \
			return 0; \
		fi; \
		BRANCH=${1:-\"-\"}; \
		if [ \"$BRANCH\" = \"!\" ]; then \
			if git config --get alias.recent > /dev/null 2>&1; then \
				git recent; \
			else \
				branches=$(git branch --format='%(refname:short)' --sort=-committerdate | grep -v \"^$(git branch --show-current)$\"); \
				if [ -z \"$branches\" ]; then \
					echo \"No other branches to switch to.\"; \
				else \
					select branch in $branches; do \
						if [ -n \"$branch\" ]; then \
							git switch \"$branch\"; \
							break; \
						else \
							echo \"Invalid selection. Please try again.\"; \
						fi; \
					done; \
				fi; \
			fi; \
		elif [ \"$BRANCH\" = \"-\" ]; then \
			git switch -; \
		elif git show-ref --verify --quiet \"refs/heads/$BRANCH\"; then \
			git switch \"$BRANCH\"; \
		else \
			git switch -c \"$BRANCH\"; \
		fi; \
	}; f"

	# TODO
