#!/usr/bin/env bash

# Determine size of a file or total size of a directory
# Usage: fs [path]
# If a path is provided, it will display the size of the specified file or directory.
# If no path is provided, it will display the size of all files and directories in the current directory.
fs() {
    if du -b /dev/null > /dev/null 2>&1; then
        local arg=-sbh;
    else
        local arg=-sh;
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@";
    else
        du $arg .[^.]* ./*;
    fi;
}

# Launch lazygit and change directory if a new directory is specified
# Usage: lg [options]
# Runs lazygit with the provided options. If a new directory is specified in ~/.lazygit/newdir, it changes to that directory.
lg()
{
    export LAZYGIT_NEW_DIR_FILE=~/.lazygit/newdir
    lazygit "$@"

    if [ -f $LAZYGIT_NEW_DIR_FILE ]; then
        cd "$(cat $LAZYGIT_NEW_DIR_FILE)"
        rm -f $LAZYGIT_NEW_DIR_FILE > /dev/null
    fi
}

# Show git diff with bat highlighting
# Usage: batdiff
# Displays the names of files changed in the git diff with syntax highlighting using bat.
batdiff() {
    git diff --name-only --diff-filter=d | xargs bat --diff
}

# Interact with a running Docker container
# Usage: dockerInteract <container_id>
# Opens an interactive shell session inside the specified Docker container.
dockerInteract() {
    docker exec -it $1 sh
}

# Display gzip compression ratio of a file or a string
# Usage: gz <file|string>
# If no arguments are provided, it reads from stdin.
# If a file is specified, shows the original size and the gzip compressed size of the file, along with the compression ratio.
# If a string is specified, shows the original size and the gzip compressed size of the string, along with the compression ratio.
gz() {
    local input
    local origsize
    local gzipsize
    local ratio

    #if there are no arguments return
    if [ -z "$1" ]; then
        return
    fi

    if [ -d "$1" ]; then # check if the argument is a directory
        input=$(mktemp)
        tar -cf - "$1" | gzip -c > "$input"
        origsize=$(du -sb "$1" 2>/dev/null | awk '{print $1}')
        if [ -z "$origsize" ]; then
            origsize=$(du -sk "$1" | awk '{print $1}')
            origsize=$((origsize * 1024))
        fi
        gzipsize=$(wc -c < "$input")
    else
        if [ -f "$1" ]; then # check if the argument is a file
            input="$1"
        else # treat the argument as a string
            input=$(mktemp)
            printf "%s\n" "$@" > "$input"
        fi
        origsize=$(wc -c < "$input")
        gzipsize=$(gzip -c < "$input" | wc -c)
    fi

    ratio=$(awk "BEGIN {printf \"%.2f\", $gzipsize * 100 / $origsize}")
    orig_human=$(numfmt --to=iec "$origsize" | xargs)
    gzip_human=$(numfmt --to=iec "$gzipsize" | xargs)

    printf "orig: %d bytes (%s)\ngzip: %d bytes (%s) (%.2f%%)\n" \
        "$origsize" "$orig_human" \
        "$gzipsize" "$gzip_human" \
        "$ratio"

    [[ "$input" == /tmp/* ]] && rm -f "$input"
}

# Remove node_modules directories
# Usage: npmRemove [-dry]
# If the -dry option is provided, it displays the sizes of all node_modules directories.
# Otherwise, it removes all node_modules directories in the current directory and its subdirectories.
npmRemove() {
    if [ "$1" = "-dry" ]; then
        find . -name "node_modules" -type d -prune -exec du -chs {} +
    else
        find . -name "node_modules" -type d -prune -exec rm -rf {} +
    fi
}

# Generate a random password of a specified length using OpenSSL
# Usage: pw [length]
# Generates a random password of the specified length. Defaults to 24 if no length is specified.
pw() {
    local length=${1:-24}
    # Use base64, remove non-alphanumeric, and trim to length
    LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c "$length"
    echo
}

cal-year() {
    local year=${1:-$(date +%Y)}
    _ncal_highlight "$year"
}

cal-holidays() {
    local input=${1:-$(date +%Y)}
    [[ "$input" == "today" ]] && input=$(date +%Y-%m-%d)
    local year cache_dir cache_file

    if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        year="${input%%-*}"
    else
        year="$input"
    fi

    cache_dir="$HOME/.dotfiles/.cache/holidays"
    cache_file="$cache_dir/${year}.json"

    mkdir -p "$cache_dir"

    if [[ ! -f "$cache_file" ]]; then
        curl -s "https://api.dagsmart.se/holidays?year=${year}" > "$cache_file"
        if [[ $? -ne 0 || ! -s "$cache_file" ]]; then
            rm -f "$cache_file"
            echo "Failed to fetch holidays for ${year}"
            return 1
        fi
    fi

    if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        python3 - "$cache_file" "$input" <<'PYEOF'
import json, sys
cache_file, target = sys.argv[1], sys.argv[2]
with open(cache_file) as f:
    holidays = json.load(f)
matches = [h for h in holidays if h["date"] == target]
if matches:
    for h in matches:
        print(f"{h['date']}  {h['name']['sv']} ({h['name']['en']})")
else:
    print(f"No holiday on {target}")
PYEOF
        return
    fi

    _ncal_highlight "$year" "$cache_file"
}

_ncal_highlight() {
    python3 - "$1" "${2:-}" <<'PYEOF'
import subprocess, sys, re, json
from datetime import date

year = sys.argv[1]
cache_file = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else None

today = date.today()
today_tuple = (today.month, today.day) if str(today.year) == year else None

holiday_set = set()
if cache_file:
    with open(cache_file) as f:
        for h in json.load(f):
            parts = h["date"].split("-")
            holiday_set.add((int(parts[1]), int(parts[2])))

RED = "\033[1;31m"
REVERSE = "\033[7m"
RESET = "\033[0m"

months_order = [
    ["January", "February", "March", "April"],
    ["May", "June", "July", "August"],
    ["September", "October", "November", "December"],
]

month_to_num = {m: i for i, ms in enumerate(months_order, 0) for _ in [None]
               for m, i in []}  # replaced below
month_to_num = {}
for gi, group in enumerate(months_order):
    for ci, m in enumerate(group):
        month_to_num[m] = gi * 4 + ci + 1

COL_WIDTH = 18

result = subprocess.run(["ncal", "-w", year], capture_output=True, text=True)
lines = result.stdout.split("\n")

header_positions = {}
for li, l in enumerate(lines):
    names = re.findall(r'[A-Z][a-z]+', l)
    if names and names[0] in month_to_num:
        header_positions[li] = names

for line in lines:
    if not line.strip() or line.strip() == year:
        print(line)
        continue

    row_label = line[:4].rstrip()
    if row_label not in ("Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"):
        print(line)
        continue

    line_idx = lines.index(line)
    group_idx = None
    for hp in sorted(header_positions.keys()):
        if hp < line_idx < hp + 10:
            names = header_positions[hp]
            for gi, group in enumerate(months_order):
                if group[0] == names[0]:
                    group_idx = gi
                    break
            break

    if group_idx is None:
        print(line)
        continue

    content = line[4:]
    new_chunks = []
    for ci in range(4):
        start = ci * COL_WIDTH
        end = start + COL_WIDTH
        chunk = content[start:end] if start < len(content) else ""
        month_num = month_to_num[months_order[group_idx][ci]]

        new_chunk = chunk
        offset = 0
        for m in re.finditer(r'\d+', chunk):
            day_val = int(m.group())
            is_holiday = (month_num, day_val) in holiday_set
            is_today = today_tuple == (month_num, day_val)
            if is_holiday or is_today:
                if is_holiday and is_today:
                    fmt = f"{RED}{REVERSE}{m.group()}{RESET}"
                elif is_holiday:
                    fmt = f"{RED}{m.group()}{RESET}"
                else:
                    fmt = f"{REVERSE}{m.group()}{RESET}"
                s = m.start() + offset
                e = m.end() + offset
                new_chunk = new_chunk[:s] + fmt + new_chunk[e:]
                offset += len(fmt) - len(m.group())
        new_chunks.append(new_chunk)

    print(line[:4] + "".join(new_chunks))
PYEOF
}



# This code performs operations based on the current selection.
# It processes the selected data or code block, applying the intended logic.
# Ensure the selection is valid before executing this code.
add-mac-space() {
    local size=${1:-d}

    if [ ! $(uname -s) = 'Darwin' ]; then
        case "$size" in
            s)
                defaults write com.apple.dock persistent-apps -array-add '{"tile-type"="small-spacer-tile";}'; killall Dock
                ;;
            d)
                defaults write com.apple.dock persistent-apps -array-add '{"tile-type"="spacer-tile";}'; killall Dock
                ;;
            *)
                echo "Usage: add-mac-space [s|d]"
                ;;
        esac
    fi
}

brewfile-backup() {
    local backup_path=${1:-~/.dotfiles/brewfile}
    brew bundle dump --file="$backup_path" --force --describe --no-vscode
    echo "Brewfile backed up to $backup_path (without VSCode extensions)"
}

http-server() {
    local port=${1:-8000}
    python3 -m http.server "$port"
}