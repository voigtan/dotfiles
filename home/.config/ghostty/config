theme = Catppuccin Frappe

font-family = Monaspace Neon
font-family = Monaspace Argon
font-family = FiraCode Nerd Font Mono
font-family = Hack Nerd Font

# Enable Monaspace texture healing (calt) & coding ligatures (ss01-ss10)
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10

window-padding-x = 8

# Forward Cmd+C to TUI apps (like Neovim <D-c>) when there is no native terminal selection
keybind = performable:super+c=copy_to_clipboard
